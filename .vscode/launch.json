{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "训练 (train.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/train.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "推理 (eval.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/eval.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "转换 ONNX (convert_onnx.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/convert_onnx.py",
      "args": [
        "${workspaceFolder}/onnx/best.pt",
        "-o",
        "${workspaceFolder}/onnx/best.onnx"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}